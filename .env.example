# --- API Keys ---
# Get your AssemblyAI API key from https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Get your DeepSeek API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- Local Folder Paths ---
# The folder where audio files and local transcript files will be saved
BASE_PATH=C:\Users\yourname\Documents\Dhammarato\Dhammarato Diarized Transcript Files and Recordings

# The folder where the Dhammarato website blog posts are stored (your local clone of the site repo)
GITHUB_POSTS_PATH=C:\Users\yourname\path\to\dhammarato-site\src\content\blog

# The path to the list of YouTube video URLs to process
VIDEO_URLS_PATH=C:\Users\yourname\path\to\Dhammarato Transcription Scripts\list_of_videos.txt
